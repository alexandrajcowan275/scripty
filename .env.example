# Cached public demo; live mode is operator-controlled.
DEMO_MODE=cached
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_IMAGE_QUALITY=high
OPENAI_MONITOR_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_RULE_MODEL=gpt-4.1-mini
# Optional alternative provider; deferred by MVP.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed for remote project images outside storage origin.
NEXT_PUBLIC_SITE_URL=
# Generate stable random values. Never prefix secrets with NEXT_PUBLIC_.
CANON_SESSION_SECRET=
CANON_ADMIN_TOKEN=
# CLI/migrations only; runtime uses Supabase HTTPS API.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Live generation requires BOTH this switch and the server-only access code.
CANON_PUBLIC_GENERATION_ENABLED=false

# Set in .env.local and Vercel Production environment variables; never NEXT_PUBLIC_.
SCRIPTY_ACCESS_CODE=
# Operator test server only: atomic testing ceiling $12; ab_test also has a $3 ceiling.
# SCRIPTY_BUDGET_SCOPE=verification
